#!/usr/bin/env bash
# The one build recipe: Task and the workflows both run this, so a
# binary is built the same way everywhere. Officially reproducible —
# no wall clock, no CGO, trimmed paths, native VCS stamping that FAILS
# if the data exists but cannot be embedded.
#
#   scripts/build -o bin/lotor [-version 1.2.3] [-tags lean]
#                 [-goos linux] [-goarch arm64] [-goarm 7] [pkg]
set -euo pipefail
cd "$(dirname "$0")/.."

out="" version="" tags="" goos="" goarch="" goarm="" pkg="./cmd/lotor"
while [ $# -gt 0 ]; do
  case "$1" in
    -o)       out="$2"; shift 2 ;;
    -version) version="$2"; shift 2 ;;
    -tags)    tags="$2"; shift 2 ;;
    -goos)    goos="$2"; shift 2 ;;
    -goarch)  goarch="$2"; shift 2 ;;
    -goarm)   goarm="$2"; shift 2 ;;
    -*)       echo "build: unknown flag $1" >&2; exit 2 ;;
    *)        pkg="$1"; shift ;;
  esac
done
: "${out:?build: -o names the output}"

ldflags="-s -w"
if [ -n "$version" ]; then
  ldflags="$ldflags -X meshrunner.dev/lotor/internal/version.release=${version}"
fi
args=(-trimpath -buildvcs=true -ldflags "$ldflags" -o "$out")
[ -n "$tags" ] && args+=(-tags "$tags")

GOOS="${goos:-}" GOARCH="${goarch:-}" GOARM="${goarm:-}" CGO_ENABLED=0 \
  go build "${args[@]}" "$pkg"

# A git checkout must yield a stamped binary. -buildvcs=true fails
# when it finds a repository it cannot read, but a checkout it does
# not recognise as one at all — a git worktree, for instance — leaves
# the binary silently unstamped, provenance lost with no error. A
# packager building from a tarball has no repository and keeps its
# fallbacks; a checkout that has one owes the revision.
if git rev-parse --git-dir >/dev/null 2>&1 &&
   ! go version -m "$out" | grep -q "vcs.revision="; then
  echo "build: this is a git checkout but $out carries no revision" >&2
  echo "build: go stamped nothing — check that the build ran inside the repository" >&2
  exit 1
fi
