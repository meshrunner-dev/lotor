# Lotor mesh relay daemon.
#
# Runs as the dedicated lotor user: the radio needs nothing but the
# spi and gpio groups, the configuration database and the journal live
# in StateDirectory, the admin console socket in RuntimeDirectory.
# Nothing outside those is written — ProtectSystem=strict holds with
# no carve-outs.
[Unit]
Description=Lotor mesh relay daemon
Documentation=https://meshrunner.dev/lotor
After=network.target

[Service]
ExecStart=/usr/local/bin/lotor run
Restart=on-failure
RestartSec=5

User=lotor
Group=lotor
SupplementaryGroups=spi gpio
StateDirectory=lotor
RuntimeDirectory=lotor
RuntimeDirectoryMode=0750

# No privileges to escalate, no devices beyond the radio, no view of
# anything the daemon does not own. The device allowlist names kernel
# character-device groups, not nodes: every SPI controller and GPIO
# chip a board may carry, on any bus index, present or hotplugged.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-spi rw
DeviceAllow=char-gpiochip rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077

[Install]
WantedBy=multi-user.target
